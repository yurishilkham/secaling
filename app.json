{
  "expo": {
    "name": "Secaling",
    "slug": "Secaling",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "secaling",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ECF2EE",
    "android": {
      "package": "com.secaling.app",
      "versionCode": 4,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E7F5EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            {
              "scheme": "secaling",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlusJakartaSans-Regular.ttf",
            "./assets/fonts/PlusJakartaSans-Medium.ttf",
            "./assets/fonts/PlusJakartaSans-SemiBold.ttf",
            "./assets/fonts/PlusJakartaSans-Bold.ttf",
            "./assets/fonts/PlusJakartaSans-ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#047857",
          "dark": {
            "backgroundColor": "#101A15"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Secaling perlu izin membuka galeri agar Anda bisa memilih foto sebagai bukti laporan keamanan desa.",
          "cameraPermission": "Secaling perlu izin memakai kamera agar Anda bisa memfoto langsung kejadian yang dilaporkan.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C81E1E",
          "defaultChannel": "alerts"
        }
      ],
      "./plugins/with-release-signing.js",
      "./plugins/with-gradle-memory.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2d796e14-ceca-47f0-ae1f-c35ee6c68e4b"
      }
    },
    "owner": "ridztemplate11",
    "updates": {
      "url": "https://u.expo.dev/2d796e14-ceca-47f0-ae1f-c35ee6c68e4b",
      "fallbackToCacheTimeout": 3000,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
