# Kredensial Firebase untuk notifikasi push.
# Bukan rahasia sekelas kunci privat, tapi terikat pada project Firebase desa
# dan sebaiknya tidak tersebar di repo publik.
google-services.json
GoogleService-Info.plist

# Kunci privat service account Firebase (dipakai EAS untuk MENGIRIM notifikasi).
# Ini rahasia sungguhan: siapa pun yang punya berkas ini bisa mengakses
# project Firebase desa.
*-firebase-adminsdk-*.json

# Keystore penandatanganan APK.
# Kalau ini hilang, TIDAK ADA cara mengirim pembaruan ke APK yang sudah
# terpasang di HP warga — mereka harus hapus dan pasang ulang. Simpan salinannya
# di luar laptop (Drive, flashdisk), bukan hanya di sini.
*.jks
*.keystore
!android/app/debug.keystore

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

gradle-*.log

